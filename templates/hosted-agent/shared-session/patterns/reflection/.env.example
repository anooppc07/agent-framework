# Local runs only; a deployed agent gets these from azure.yaml. Never commit a real .env.
# Model: through the AI Gateway (DataX supplies these; none is in the architecture KB).
GATEWAY_MODELS_BASE_URL=https://<apim-host>/<models-api-path>/v1
GATEWAY_MODEL_NAME=<logical-model-name>
GATEWAY_TOKEN_SCOPE=api://<gateway-app-id>/.default

# State: your PortCo's Cosmos DB account. Entra sign-in only; there is no key setting here by design.
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_DATABASE_NAME=agent-framework
# Containers must already exist (infra/cosmos/main.tf creates them); the app never creates any.
COSMOS_HISTORY_CONTAINER=chat-history
COSMOS_FACTS_CONTAINER=shared-facts
COSMOS_CHECKPOINT_CONTAINER=workflow-checkpoints

# Retention (match the Terraform variables; Terraform owns the container TTL, these set each fact's own TTL).
FACT_TTL_SECONDS=86400
HISTORY_TTL_SECONDS=2592000
CHECKPOINT_TTL_SECONDS=604800

# Who the tenant is: one hosted agent per company. A multi-company host must resolve this per request.
TENANT_ID=<your-company-id>
# dev, test or local allow a non-secret pepper. Anything else REQUIRES SCOPE_HASH_PEPPER (32+ chars, from Key Vault;
# openssl rand -hex 32). Every service that must see the same data needs the same value. Changing it later
# orphans everything stored (new partitions), so set it once.
APP_ENV=production
SCOPE_HASH_PEPPER=<from-key-vault>

# Keep prompts and replies out of traces (R7). Both lines are needed; see ../../observability/README.md.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
ENABLE_SENSITIVE_DATA=false
