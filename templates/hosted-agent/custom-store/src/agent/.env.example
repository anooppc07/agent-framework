# Local runs only; a deployed agent gets these from azure.yaml. Never commit a real .env.
GATEWAY_MODELS_BASE_URL=https://<apim-host>/<models-api-path>/v1
GATEWAY_MODEL_NAME=<logical-model-name>
GATEWAY_TOKEN_SCOPE=api://<gateway-app-id>/.default

# All four stores share one Redis. REDIS_URL selects a local Redis for development.
# When deployed, azd injects REDIS_HOST / REDIS_PORT and the agent signs in with its managed identity.
REDIS_URL=redis://localhost:6379/0
# Identity used to partition local, unhosted requests.
LOCAL_STORE_USER_ID=local-developer
# Retention for stored responses only (seconds). Sessions, checkpoints and approvals do NOT expire.
REDIS_RESPONSE_TTL_SECONDS=86400

OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
ENABLE_SENSITIVE_DATA=false
