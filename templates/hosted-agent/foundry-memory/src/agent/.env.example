# Local runs only; a deployed agent gets these from azure.yaml. Never commit a real .env.
GATEWAY_MODELS_BASE_URL=https://<apim-host>/<models-api-path>/v1
GATEWAY_MODEL_NAME=<logical-model-name>
GATEWAY_TOKEN_SCOPE=api://<gateway-app-id>/.default

# Memory store (inside the Foundry account; the documented gateway exception).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
MEMORY_STORE_NAME=scbx_memory
# Deployments the memory store itself uses. They must be on the approved-model list.
AZURE_AI_MODEL_DEPLOYMENT_NAME=<in-account chat deployment>
AZURE_AI_EMBEDDING_MODEL_DEPLOYMENT_NAME=<in-account embedding deployment>

OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
ENABLE_SENSITIVE_DATA=false
